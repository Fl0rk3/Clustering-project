world <- ne_countries(scale = "medium", returnclass = "sf")
View(world)
# See what the country name column looks like
names(world)
unique(world$admin[world$admin %in% c("Germany", "Spain")])
# mapping from your names -> world$admin (non-UK only)
non_uk_lookup <- countries |>
filter(!Country %in% c("England", "Scotland", "Wales", "Northern Ireland")) |>
mutate(
admin = case_when(
Country == "USA"   ~ "United States of America",
Country == "Russia" ~ "Russian Federation",
TRUE                ~ Country  # assume others match as-is
)
)
countries <- leagues |>
count(Country, name = "n_leagues")
View(countries)
# mapping from your names -> world$admin (non-UK only)
non_uk_lookup <- countries |>
filter(!Country %in% c("England", "Scotland", "Wales", "Northern Ireland")) |>
mutate(
admin = case_when(
Country == "USA"   ~ "United States of America",
Country == "Russia" ~ "Russian Federation",
TRUE                ~ Country  # assume others match as-is
)
)
world_non_uk <- world |>
inner_join(non_uk_lookup, by = c("admin" = "admin"))
View(world_non_uk)
uk_states <- ne_states(country = "United Kingdom", returnclass = "sf")
View(uk_states)
home_nations_shapes <- uk_states |>
filter(name %in% c("England", "Scotland", "Wales", "Northern Ireland"))
home_nations_data <- countries |>
filter(Country %in% c("England", "Scotland", "Wales", "Northern Ireland"))
home_nations <- home_nations_shapes |>
left_join(home_nations_data, by = c("name" = "Country"))
world_leagues <- bind_rows(
world_non_uk |> select(name = Country, n_leagues, geometry),
home_nations |> select(name, n_leagues, geometry)
)
# basic map – fill by number of leagues (or just presence)
ggplot(world_leagues) +
geom_sf(aes(fill = n_leagues), color = "grey30", linewidth = 0.1) +
scale_fill_viridis_c(option = "plasma", direction = -1, na.value = "grey90") +
theme_minimal() +
theme(
axis.text = element_blank(),
axis.title = element_blank()
)
leagues <- read.csv('Scrapping/leagues.csv')
library(sf)
library(dplyr)
library(ggplot2)
library(rnaturalearth)
leagues_by_country <- leagues |>
count(Country, name = "n_leagues")
View(leagues_by_country)
world <- ne_countries(scale = "medium", returnclass = "sf")
# which countries in your data are NOT UK home nations
non_home <- leagues_by_country |>
filter(!Country %in% c("England", "Scotland", "Wales", "Northern Ireland")) |>
mutate(
# map your names to world$admin where needed
admin_map = case_when(
Country == "USA"   ~ "United States of America",
Country == "Russia" ~ "Russian Federation",
TRUE                ~ Country      # assume the rest match
)
)
# left_join = KEEP ALL world countries (they just get NA n_leagues if absent)
world_non_uk <- world |>
filter(admin != "United Kingdom") |>
left_join(non_home, by = c("admin" = "admin_map"))
uk_states <- ne_states(country = "United Kingdom", returnclass = "sf")
home_nations_data <- leagues_by_country |>
filter(Country %in% c("England", "Scotland", "Wales", "Northern Ireland"))
home_nations <- uk_states |>
filter(name %in% c("England", "Scotland", "Wales", "Northern Ireland")) |>
left_join(home_nations_data, by = c("name" = "Country"))
world_final <- bind_rows(
world_non_uk |> select(name = admin, n_leagues, geometry),
home_nations |> select(name, n_leagues, geometry)
)
ggplot(world_final) +
geom_sf(aes(fill = n_leagues), color = "grey30", linewidth = 0.1) +
scale_fill_viridis_c(
option   = "plasma",
direction = -1,
na.value = "grey90",          # countries with no leagues = grey
name = "n_leagues"
) +
theme_minimal() +
theme(
axis.text  = element_blank(),
axis.title = element_blank()
)
View(home_nations)
View(home_nations_data)
View(uk_states)
