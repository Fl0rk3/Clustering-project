plot_silhouette_kmeans <- fviz_nbclust(l_data_z, kmeans, method = "silhouette")
grid.arrange(plot_wws_kmeans, plot_silhouette_kmeans, ncol=2)
# K-means
kmeans4_l <- kmeans(l_data_z, 4, nstart=25)
sil_kmeans4_l <- silhouette(kmeans4_l$cluster, dist(l_data_z))
fviz_silhouette(sil_kmeans4_l) # 0.29
round(calinhara(l_data_z, kmeans4_l$cluster), digits = 2) # 68
kmeans3_l <- kmeans(l_data_z, 3, nstart=25)
sil_kmeans3_l <- silhouette(kmeans3_l$cluster, dist(l_data_z))
fviz_silhouette(sil_kmeans3_l) # 0.26
round(calinhara(l_data_z, kmeans3_l$cluster), digits = 2) # 63.12
fviz_cluster(kmeans4_l, data = l_data_z, frame = FALSE, geom = "point")
