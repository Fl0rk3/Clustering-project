library(worldfootballR)
library(dplyr)
library(tidyr)
library(stringr)
intl_comps <- c(
"FIFA World Cup",
"FIFA World Cup Qualification — AFC",
"FIFA World Cup Qualification — CAF",
"FIFA World Cup Qualification — CONCACAF",
"FIFA World Cup Qualification — CONMEBOL",
"FIFA World Cup Qualification — Inter-confederation play-offs",
"FIFA World Cup Qualification — OFC",
"FIFA World Cup Qualification — UEFA",
"AFC Asian Cup",
"AFC Asian Cup qualification",
"Africa Cup of Nations",
"Africa Cup of Nations qualification",
"CONCACAF Gold Cup",
"CONMEBOL Copa América",
"OFC Nations Cup",
"UEFA European Football Championship",
"UEFA European Football Championship Qualifying",
"UEFA Nations League",
"International Friendlies (M)",
"International Friendlies (W)"
)
intl_matches <- load_match_comp_results(comp_name = intl_comps)
teams_raw <- intl_matches %>%
select(Home, Away) %>%
pivot_longer(cols = everything(), values_to = "team") %>%
distinct(team) %>%
arrange(team)
head(teams_raw$team, 20)
length(teams_raw$team)
clean_team_name <- function(x) {
# split on spaces
parts <- str_split(x, "\\s+", simplify = TRUE)
parts <- parts[parts != ""]
# drop pure 2-letter lowercase bits (like 'br', 'ng', 'cn', 'no')
parts <- parts[!str_detect(parts, "^[a-z]{2}$")]
str_trim(paste(parts, collapse = " "))
}
teams <- teams_raw %>%
mutate(country = vapply(team, clean_team_name, FUN.VALUE = character(1))) %>%
distinct(country) %>%
arrange(country)
head(teams$country, 30)
nrow(teams)
